<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(TextSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>TextSpace</ApplicationTitle>
    <ApplicationId>io.github.wieslawsoltes.textspace</ApplicationId>
    <ApplicationDisplayVersion>0.5.1</ApplicationDisplayVersion>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationPublisher>TextSpace contributors</ApplicationPublisher>
    <Description>Local-first word processing with Uno Platform and SkiaSharp.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
    <!-- Uno 6.7's generated entry bootstrap can retain the build-time JS hash
         after .NET 10 publish re-fingerprints dotnet.js. Keep the SDK-supported
         stable entry filename; managed/native payloads retain their own hashes. -->
    <WasmShellEnableDotnetJsFingerprinting>false</WasmShellEnableDotnetJsFingerprinting>
    <WasmFingerprintDotnetJs>false</WasmFingerprintDotnetJs>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TextSpace.Workbench/TextSpace.Workbench.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Host.js" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Recovery.js" />
  </ItemGroup>
</Project>
